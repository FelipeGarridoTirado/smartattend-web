<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartAttend - Portal del Alumno</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav class="navbar navbar-dark bg-success mb-4 shadow-sm">
        <div class="container">
            <span class="navbar-brand mb-0 h1">SmartAttend - Portal del Alumno</span>
            <a href="/logout" class="btn btn-outline-light btn-sm">Cerrar Sesión</a>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                
                <div class="card p-4 text-center shadow-lg mb-4">
                    <h2 class="text-success mb-3">¡Bienvenido, <%= usuario.username %>!</h2>
                    <p class="lead text-muted">Aquí puedes consultar tu registro de asistencia.</p>
                </div>

                <div class="card p-4 shadow-sm">
                    <h4 class="mb-4">Mi Historial de Asistencia</h4>
                    
                    <% if (asistencias && asistencias.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-success">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% asistencias.forEach(asistencia => { %>
                                        <tr>
                                            <td><strong><%= asistencia.fecha %></strong></td>
                                            <td>
                                                <% if (asistencia.estado === 'Presente') { %>
                                                    <span class="badge bg-success py-2 px-3">Presente</span>
                                                <% } else if (asistencia.estado === 'Falta') { %>
                                                    <span class="badge bg-danger py-2 px-3">Falta</span>
                                                <% } else { %>
                                                    <span class="badge bg-warning text-dark py-2 px-3"><%= asistencia.estado %></span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="alert alert-info" role="alert">
                            No hay registros de asistencia todavía.
                        </div>
                    <% } %>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>