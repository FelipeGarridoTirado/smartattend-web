<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartAttend - Mi Asistencia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-success">
        <div class="container-fluid">
            <span class="navbar-brand mb-0 h1">SmartAttend - Portal del Alumno</span>
            <a href="/logout" class="btn btn-danger btn-sm">Cerrar Sesión</a>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="card shadow-sm p-4">
            <h3 class="text-success mb-3">¡Hola, <%= username %>!</h3>
            <p class="text-muted">Este es tu historial individual de asistencia.</p>

            <table class="table table-bordered table-striped mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha y Hora de Registro</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (asistencias.length > 0) { %>
                        <% asistencias.forEach(registro => { %>
                            <tr>
                                <td><%= registro.fecha %></td>
                                <td><span class="badge bg-success">Presente</span></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="2" class="text-center">Aún no tienes registros de asistencia.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>