<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartAttend - Panel de Administrador</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav class="navbar navbar-dark bg-primary mb-4 shadow-sm">
        <div class="container">
            <span class="navbar-brand mb-0 h1">SmartAttend - Administrador</span>
            <a href="/logout" class="btn btn-danger btn-sm">Cerrar Sesión</a>
        </div>
    </nav>

    <div class="container">
        <h2 class="mb-4 text-dark">Gestión de Alumnos</h2>

        <div class="card p-3 mb-4">
            <form action="/admin" method="GET" class="d-flex gap-2 flex-wrap align-items-center">
                
                <input type="text" name="search" class="form-control" style="flex: 1; min-width: 200px;" placeholder="Buscar alumno por nombre..." value="<%= typeof search != 'undefined' ? search : '' %>">
                
                <select name="sort" class="form-select w-auto">
                    <option value="id">Ordenar por ID</option>
                    <option value="nombre">Ordenar por Nombre</option>
                    <option value="email">Ordenar por Email</option>
                </select>

                <select name="order" class="form-select w-auto">
                    <option value="ASC">Ascendente (A-Z)</option>
                    <option value="DESC">Descendente (Z-A)</option>
                </select>

                <button type="submit" class="btn btn-primary">Aplicar</button>
                <a href="/admin" class="btn btn-outline-secondary">Limpiar</a>
            </form>
        </div>

        <div class="card p-3 mb-4">
            <h5 class="card-title">Registrar Nuevo Alumno</h5>
            <form action="/admin/add" method="POST" class="d-flex gap-2 flex-wrap">
                <input type="text" name="nombre" class="form-control" placeholder="Nombre completo" required style="flex: 1; min-width: 200px;">
                <input type="email" name="email" class="form-control" placeholder="Correo electrónico" required style="flex: 1; min-width: 200px;">
                <button type="submit" class="btn btn-success">Añadir Alumno</button>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (alumnos && alumnos.length > 0) { %>
                        <% alumnos.forEach(alumno => { %>
                            <tr>
                                <td><%= alumno.id %></td>
                                <td><%= alumno.nombre %></td>
                                <td><%= alumno.email %></td>
                                <td class="text-center">
                                    <form action="/admin/delete/<%= alumno.id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Seguro que deseas eliminar este alumno?')">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center py-3">No se encontraron alumnos.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>